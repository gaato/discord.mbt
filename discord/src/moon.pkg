import {
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "gaato/discord/app",
  "gaato/discord/bot",
  "gaato/discord/gateway",
  "gaato/discord/endpoint_http",
  "gaato/discord/verify",
  "gaato/discord/framework",
  "gaato/discord/cache",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/async",
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/interaction",
  "gaato/discord/http" @dhttp,
  "moonbitlang/async/http" @ahttp,
} for "test"

// Target-specific facade imports are unused on the other targets.

// The public Bot `resume` label is reserved by this compiler version; the
// compiled README example exercises it so documentation stays in sync.

warnings = "-29-35"

supported_targets = "js + native + wasm"

options(
  targets: {
    "overview.mbt.md": [ "native" ],
    "facade_gateway.mbt": [ "native", "js", "wasm" ],
    "facade_interactions_js.mbt": [ "js" ],
    "facade_server.mbt": [ "native", "wasm" ],
    "facade_server_test.mbt": [ "native", "wasm" ],
    "readme_native_test.mbt": [ "native" ],
  },
)
