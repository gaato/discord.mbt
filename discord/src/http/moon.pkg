import {
  "gaato/sdk-runtime/json" @sdkjson,
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/ratelimit",
  "gaato/http/clock" @hclock,
  "gaato/http" @ghttp,
  "gaato/http-async" @transport,
  "gaato/sdk-runtime" @runtime,
  "gaato/http/multipart",
  "gaato/http/random",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/debug",
  "gaato/discord/model",
  "gaato/discord/telemetry",
} for "test"

import {
  "gaato/http-async/mock" @simclock,
  "moonbitlang/async/socket",
  "moonbitlang/core/json",
} for "wbtest"

// REST transport uses async HTTP on native, JavaScript, and moonrun Wasm.

supported_targets = "js + native + wasm"

options(
  targets: { "loopback_server_wbtest.mbt": [ "native", "wasm" ] },
)
