import {
  "gaato/mttp/jsonkit" @sdkjson,
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/ratelimit",
  "gaato/mttp/rt" @hclock,
  "gaato/mttp" @ghttp,
  "gaato/mttp/client/retry",
  "gaato/mttp_async/runtime" @transport,
  "gaato/mttp/client" @runtime,
  "gaato/mttp/multipart",
  "gaato/mttp_async/backend",
  "gaato/mttp/h1client",
  "moonbitlang/core/async",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

// Only proxy_env.mbt reads the environment; see proxy_env_js.mbt.
#cfg(not(target="js"))
import {
  "moonbitlang/core/env",
}

import {
  "moonbitlang/core/debug",
  "gaato/discord/model",
  "gaato/discord/telemetry",
} for "test"

import {
  "gaato/mttp_async/runtime" @transport,
  "moonbitlang/core/json",
} for "wbtest"

#cfg(not(target="js"))
import {
  "moonbitlang/core/async/http" @ahttp,
  "moonbitlang/core/async/socket",
} for "wbtest"

// REST transport uses async HTTP on native, JavaScript, and moonrun Wasm.

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
  targets: {
    "loopback_server_wbtest.mbt": [ "native", "wasm" ],
    "proxy_env.mbt": [ "native", "wasm" ],
    "proxy_env_js.mbt": [ "js" ],
  },
)
