import {
  "gaato/sdk-runtime/json" @sdkjson,
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "gaato/discord/internal/clock",
  "gaato/http/clock" @hclock,
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/cond_var",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "gaato/discord/internal/simclock",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/random",
} for "test"

import {
  "moonbitlang/core/json",
} for "wbtest"

// `member` is part of the public TargetUser API, but MoonBit currently marks
// it as a possible future keyword before local warning attributes take effect.

warnings = "-35"

supported_targets = "js + native + wasm"

options(
  targets: {
    "gate_fuzz_seeds_test.mbt": [ "native", "wasm" ],
    "gate_fuzz_seeds_js_test.mbt": [ "js" ],
  },
)
