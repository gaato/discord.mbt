import {
  "gaato/mttp/jsonkit" @sdkjson,
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "gaato/mttp-net/runtime" @netruntime,
  "gaato/mttp/clock" @hclock,
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/cond_var",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "gaato/mttp-net/runtime" @netruntime,
  "gaato/mttp/model" @ghttp,
  "gaato/mttp/client" @runtime,
  "moonbitlang/async/aqueue",
  "moonbitlang/core/random",
  "gaato/discord/internal/fuzz",
} for "test"

import {
  "moonbitlang/core/json",
} for "wbtest"

supported_targets = "js + native + wasm"

options(
  targets: {
    "gate_fuzz_seeds_test.mbt": [ "native", "wasm" ],
    "gate_fuzz_seeds_js_test.mbt": [ "js" ],
