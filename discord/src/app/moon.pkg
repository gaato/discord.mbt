import {
  "gaato/discord/model",
  "gaato/discord/cooldown",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "gaato/discord/framework",
  "gaato/discord/verify",
  "gaato/http-async/runtime" @transport,
  "gaato/http/rt" @hclock,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/quickcheck" @qc,
  "moonbitlang/core/json",
  "gaato/discord/model",
  "hustcer/ed25519",
  "moonbitlang/core/encoding/hex",
  "gaato/http-async/runtime" @transport,
} for "test"

import {
  "hustcer/ed25519",
  "moonbitlang/core/encoding/hex",
  "gaato/http-async/runtime" @transport,
  "moonbitlang/core/random",
  "moonbitlang/core/debug",
  "gaato/discord/internal/fuzz",
} for "wbtest"

// `moonbitlang/core/async/js_async` only backs the JavaScript dispatch bridge, so
// it is an unused import on native and Wasm.

warnings = "-29"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/js_async",
  ],
  targets: {
    "interaction_http.js.mbt": [ "js" ],
    "interaction_http_js_wbtest.mbt": [ "js" ],
    "admission_fuzz_seeds_wbtest.mbt": [ "native", "wasm" ],
    "admission_fuzz_seeds_js_wbtest.mbt": [ "js" ],
    "pkg.generated.mbti": [ "native" ],
  },
)
