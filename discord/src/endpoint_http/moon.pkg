#cfg(not(target="js"))
import {
  "gaato/discord/app",
  "gaato/discord/verify",
  "gaato/discord/http" @dhttp,
  "gaato/discord/model",
  "gaato/mttp_core" @hmodel,
  "gaato/mttp_core/h1server",
  "gaato/mttp/server",
  "gaato/mttp_core/endpoint",
  "gaato/mttp_core/router",
  "gaato/mttp_core/schema",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/http" @ahttp,
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

#cfg(not(target="js"))
import {
  "gaato/discord/interaction",
  "hustcer/ed25519",
  "moonbitlang/core/async",
  "moonbitlang/core/encoding/hex",
} for "wbtest"

// The listening server uses moonrun host sockets on Wasm; it is empty on JS.

warnings = "-29"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/socket",
  ],
  targets: {
    "endpoint_http.mbt": [ "native", "wasm" ],
    "handler.mbt": [ "native", "wasm" ],
    "endpoint_http_wbtest.mbt": [ "native", "wasm" ],
    "pkg.generated.mbti": [ "native", "wasm" ],
  },
)
