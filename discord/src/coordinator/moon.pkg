// Experimental: API may change in minor releases until declared stable.

import {
  "gaato/discord/cooldown",
  "gaato/discord/internal/clock",
  "gaato/discord/queue",
  "gaato/discord/ratelimit",
  "gaato/http",
  "gaato/sdk-runtime" @runtime,
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

import {
  "gaato/discord/queue",
  "gaato/discord/ratelimit",
  "gaato/http",
  "gaato/sdk-runtime" @runtime,
  "moonbitlang/async",
} for "wbtest"

// TCP coordination runs on native and moonrun Wasm; this package is empty on JS.

supported_targets = "js + native + wasm"

warnings = "-29"

options(
  targets: {
    "coordinator_wbtest.mbt": [ "native", "wasm" ],
    "pkg.generated.mbti": [ "native", "wasm" ],
    "protocol.mbt": [ "native", "wasm" ],
    "protocol_wbtest.mbt": [ "native", "wasm" ],
    "remote.mbt": [ "native", "wasm" ],
    "server.mbt": [ "native", "wasm" ],
  },
)
