import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/queue",
  "gaato/http-async" @transport,
  "gaato/http/clock" @hclock,
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "gaato/discord/internal/websocket",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/encoding/utf8",
  "moonbit-community/flate/zlib",
  "gaato/zstd",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/json",
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/queue",
  "gaato/http-async/mock" @simclock,
  "gaato/discord/internal/gatewaysim",
  "gaato/http/clock" @hclock,
  "moonbitlang/core/random",
  "moonbitlang/core/debug",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/async/socket",
  "moonbitlang/async/websocket" @asyncws,
  "gaato/discord/internal/fuzz",
} for "test"

import {
  "gaato/http-async/mock" @simclock,
} for "wbtest"

// The gateway, including zlib-stream and zstd-stream compression, runs on native, JavaScript, and moonrun Wasm.

// `resume` is the public API label and is reserved by the current compiler.

warnings = "-29-35"

supported_targets = "js + native + wasm"

options(
  targets: {
    "command_limit.mbt": [ "js", "native", "wasm" ],
    "command_limit_wbtest.mbt": [ "js", "native", "wasm" ],
    "capabilities_test.mbt": [ "js", "native", "wasm" ],
    "compression.mbt": [ "js", "native", "wasm" ],
    "compression_wbtest.mbt": [ "js", "native", "wasm" ],
    "frame.mbt": [ "js", "native", "wasm" ],
    "frame_wbtest.mbt": [ "js", "native", "wasm" ],
    "gateway_test.mbt": [ "js", "native", "wasm" ],
    "extends.mbt": [ "js", "native", "wasm" ],
    "heartbeat.mbt": [ "js", "native", "wasm" ],
    "heartbeat_wbtest.mbt": [ "js", "native", "wasm" ],
    "inflater.mbt": [ "js", "native", "wasm" ],
    "pkg.generated.mbti": [ "native" ],
    "platform.js.mbt": [ "js" ],
    "platform_native.mbt": [ "native", "wasm" ],
    "reconnect.mbt": [ "js", "native", "wasm" ],
    "reconnect_wbtest.mbt": [ "js", "native", "wasm" ],
    "shard.mbt": [ "js", "native", "wasm" ],
    "shard_fuzz_test.mbt": [ "js", "native", "wasm" ],
    "shard_fuzz_seeds_test.mbt": [ "native", "wasm" ],
    "shard_fuzz_seeds_js_test.mbt": [ "js" ],
    "state.mbt": [ "js", "native", "wasm" ],
    "transport.mbt": [ "js", "native", "wasm" ],
    "transport_native_test.mbt": [ "native" ],
  },
)
