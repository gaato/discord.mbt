import {
  "gaato/http",
  "gaato/http/rt" @clock,
  "gaato/http-async/runtime" @transport,
  "gaato/mttp/client/ratelimit" @limits,
}

import {
  "gaato/http/sim" @mock,
  "moonbitlang/core/async",
} for "test"

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
