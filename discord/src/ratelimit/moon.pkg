import {
  "gaato/mttp_core" @http,
  "gaato/mttp_core/rt" @clock,
  "gaato/mttp/runtime" @transport,
  "gaato/mttp_core/client/ratelimit" @limits,
}

import {
  "gaato/mttp_core/sim" @mock,
  "moonbitlang/core/async",
} for "test"

import {
  "moonbitlang/core/async",
} for "wbtest"

supported_targets = "js + native + wasm"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
