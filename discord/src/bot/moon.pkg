import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/cache",
  "gaato/discord/http" @dhttp,
  "gaato/discord/gateway",
  "gaato/discord/queue",
  "gaato/discord/framework",
  "gaato/discord/app",
  "gaato/http-async" @transport,
  "gaato/http/clock" @hclock,
  "moonbitlang/core/json",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/cond_var",
  "moonbitlang/core/random",
}

import {
  "moonbitlang/core/json",
  "gaato/discord/telemetry",
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
} for "test"

import {
  "gaato/discord/interaction",
  "gaato/http-async/mock" @simclock,
  "gaato/discord/internal/gatewaysim",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/debug",
  "moonbitlang/async/aqueue",
} for "wbtest"

// The gateway executor runs on native, JavaScript, and moonrun Wasm.

// `resume` is the public API label and is reserved by the current compiler.

warnings = "-29-35"

supported_targets = "js + native + wasm"

options(
  targets: {
    "runtime_fuzz_seeds_wbtest.mbt": [ "native", "wasm" ],
    "runtime_fuzz_seeds_js_wbtest.mbt": [ "js" ],
  },
)
