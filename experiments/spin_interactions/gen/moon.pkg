warnings = "-44"

supported_targets = "wasm"

import {
  "gaato/spin-discord/gen/interface/wasi/http/incoming-handler",
}

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportHandle:wasi:http/incoming-handler@0.2.6#handle",
      ],
    },
  },
)
