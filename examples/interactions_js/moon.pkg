import {
  "gaato/discord",
  "gaato/discord/model",
  "moonbitlang/core/async",
  "moonbitlang/core/async/js_async",
}

// The shared App also builds on native for command registration.

warnings = "-29"

supported_targets = "js + native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/js_async",
  ],
  link: { "js": { "exports": [ "start_signed_interaction" ], "format": "esm" } },
  targets: { "worker.mbt": [ "js" ] },
)
