import {
  "gaato/discord",
  "gaato/discord/gateway",
  "gaato/discord/model",
  "moonbitlang/core/async",
  "moonbitlang/core/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

warnings = "-29"

supported_targets = "js + native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/js_async",
  ],
  link: { "js": { "exports": [ "start_bot" ], "format": "esm" } },
  targets: { "worker.mbt": [ "js" ], "worker_wbtest.mbt": [ "js" ] },
)
