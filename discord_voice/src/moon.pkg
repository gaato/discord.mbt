// Experimental: API may change in minor releases until declared stable.

import {
  "gaato/dave",
  "gaato/discord/bot",
  "gaato/discord/model",
  "gaato/mttp/rt" @hclock,
  "gaato/mttp_async/runtime" @transport,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/async/io",
  "moonbitlang/core/async/websocket",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
}

import {
  "gaato/discord",
  "gaato/discord_voice" @voice,
  "gaato/mttp_async/runtime" @transport,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/io",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/async/http" @ahttp,
  "moonbitlang/core/async/socket",
  "moonbitlang/core/async/websocket" @asyncws,
} for "test"

import {
  "gaato/discord/app",
  "gaato/mttp_async/runtime" @transport,
  "moonbitlang/core/encoding/hex",
} for "wbtest"

// Voice networking runs only on the native async runtime.

warnings = "-29"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/websocket",
    "moonbitlang/core/async/socket",
    "moonbitlang/core/async/http",
  ],
  "native-stub": [ "shim_stub.c" ],
)
