// Experimental: API may change in minor releases until declared stable.

import {
  "gaato/dave",
  "gaato/discord/bot",
  "gaato/discord/model",
  "gaato/mttp_core/rt" @hclock,
  "gaato/mttp/runtime" @transport,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/cond_var",
  "moonbitlang/core/async/io",
  "gaato/mttp/ws",
  "gaato/mttp_core/ws" @core_ws,
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
}

import {
  "gaato/discord",
  "gaato/discord_voice" @voice,
  "gaato/mttp/runtime" @transport,
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/io",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/async/socket",
  "gaato/mttp/ws",
  "gaato/mttp/server",
  "gaato/mttp_core/h1server",
} for "test"

import {
  "gaato/discord/app",
  "gaato/mttp/runtime" @transport,
  "moonbitlang/core/encoding/hex",
  "gaato/mttp_core/sim",
  "gaato/mttp_core" @hmodel,
  "gaato/mttp_core/ws/frame" @wsframe,
} for "wbtest"

// Voice networking runs only on the native async runtime.

warnings = "-29"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/cond_var",
    "moonbitlang/core/async/io",
    "moonbitlang/core/async/socket",
  ],
  "native-stub": [ "shim_stub.c" ],
)
