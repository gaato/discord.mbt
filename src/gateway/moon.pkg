import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/queue",
  "gaato/discord/internal/clock",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "gaato/discord/internal/websocket",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/json",
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/queue",
  "gaato/discord/internal/clock",
} for "test"

// The gateway runs on native, JavaScript, and moonrun Wasm; zlib-stream compression is native-only.

// `resume` is the public API label and is reserved by the current compiler.

warnings = "-29-35"

supported_targets = "js + native + wasm"

options(
  "native-stub": [ "zlib_stream.c" ],
  targets: {
    "command_limit.mbt": [ "js", "native", "wasm" ],
    "command_limit_wbtest.mbt": [ "js", "native", "wasm" ],
    "compression.mbt": [ "native" ],
    "compression_unsupported.mbt": [ "js", "wasm" ],
    "compression_wbtest.mbt": [ "native" ],
    "capabilities_test.mbt": [ "js", "native", "wasm" ],
    "gateway_js_test.mbt": [ "js" ],
    "gateway_test.mbt": [ "js", "native", "wasm" ],
    "extends.mbt": [ "js", "native", "wasm" ],
    "inflater.mbt": [ "js", "native", "wasm" ],
    "pkg.generated.mbti": [ "native" ],
    "platform.js.mbt": [ "js" ],
    "platform_native.mbt": [ "native", "wasm" ],
    "shard.mbt": [ "js", "native", "wasm" ],
    "state.mbt": [ "js", "native", "wasm" ],
    "transport.mbt": [ "js", "native", "wasm" ],
  },
)
