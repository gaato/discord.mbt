import {
  "gaato/discord",
  "gaato/discord/http" @dhttp,
  "gaato/discord/model",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
} for "test"

// This example is intentionally empty on non-JavaScript targets.

warnings = "-29"

supported_targets = "js + native"

options(
  link: {
    "js": {
      "exports": [ "start_interaction", "verify_signature" ],
      "format": "esm",
    },
  },
  targets: { "worker.mbt": [ "js" ], "worker_wbtest.mbt": [ "js" ] },
)
