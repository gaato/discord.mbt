// Experimental: API may change in minor releases until declared stable.

import {
  "gaato/dave",
  "gaato/discord/internal/clock",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/io",
  "moonbitlang/async/websocket",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/pipe",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
} for "test"

import {
  "moonbitlang/core/encoding/hex",
} for "wbtest"

// Voice networking is available only on the native async runtime.
// This package is intentionally empty on non-native targets.

warnings = "-29"

supported_targets = "js + native + wasm"

options(
  "native-stub": [ "shim_stub.c" ],
  targets: {
    "audio.mbt": [ "native" ],
    "audio_test.mbt": [ "native" ],
    "crypto.mbt": [ "native" ],
    "crypto_test.mbt": [ "native" ],
    "crypto_wbtest.mbt": [ "native" ],
    "connection.mbt": [ "native" ],
    "connection_test.mbt": [ "native" ],
    "dave.mbt": [ "native" ],
    "dave_shim_test.mbt": [ "native" ],
    "dave_state_wbtest.mbt": [ "native" ],
    "envelope.mbt": [ "native" ],
    "envelope_test.mbt": [ "native" ],
    "envelope_error_test.mbt": [ "native" ],
    "gateway.mbt": [ "native" ],
    "ogg_opus.mbt": [ "native" ],
    "ogg_opus_test.mbt": [ "native" ],
    "ogg_opus_error_test.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "rtp.mbt": [ "native" ],
    "rtp_test.mbt": [ "native" ],
    "reorder.mbt": [ "native" ],
    "reorder_test.mbt": [ "native" ],
    "receive.mbt": [ "native" ],
    "receive_wbtest.mbt": [ "native" ],
    "receive_drop_wbtest.mbt": [ "native" ],
    "shim_ffi.mbt": [ "native" ],
    "state.mbt": [ "native" ],
    "state_test.mbt": [ "native" ],
    "subscribe.mbt": [ "native" ],
    "transport.mbt": [ "native" ],
    "udp.mbt": [ "native" ],
    "udp_test.mbt": [ "native" ],
    "udp_error_test.mbt": [ "native" ],
    "voice_gateway_test.mbt": [ "native" ],
  },
)
