import {
  "gaato/discord/app",
  "gaato/discord/verify",
  "gaato/discord/http" @dhttp,
  "gaato/discord/model",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

import {
  "gaato/discord/interaction",
  "hustcer/ed25519",
  "moonbitlang/async",
  "moonbitlang/core/encoding/hex",
} for "wbtest"

// The listening server uses moonrun host sockets on Wasm; it is empty on JS.

warnings = "-29"

supported_targets = "js + native + wasm"

options(
  targets: {
    "endpoint_http.mbt": [ "native", "wasm" ],
    "endpoint_http_wbtest.mbt": [ "native", "wasm" ],
    "pkg.generated.mbti": [ "native", "wasm" ],
  },
)
