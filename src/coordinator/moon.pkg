// Experimental: API may change in minor releases until declared stable.

import {
  "gaato/discord/cooldown",
  "gaato/discord/queue",
  "gaato/discord/ratelimit",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

import {
  "gaato/discord/queue",
  "gaato/discord/ratelimit",
  "gaato/discord/internal/clock",
  "moonbitlang/async",
} for "wbtest"

// This package is intentionally empty on non-native targets.

supported_targets = "js + native"

warnings = "-29"

options(
  targets: {
    "coordinator_wbtest.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "protocol.mbt": [ "native" ],
    "remote.mbt": [ "native" ],
    "server.mbt": [ "native" ],
  },
)
