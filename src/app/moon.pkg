import {
  "gaato/discord/model",
  "gaato/discord/cooldown",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "gaato/discord/framework",
  "gaato/discord/verify",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/quickcheck" @qc,
  "moonbitlang/core/json",
  "gaato/discord/model",
  "hustcer/ed25519",
  "moonbitlang/core/encoding/hex",
} for "test"

import {
  "hustcer/ed25519",
  "moonbitlang/core/encoding/hex",
} for "wbtest"

// `moonbitlang/async/js_async` only backs the JavaScript dispatch bridge, so
// it is an unused import on native and Wasm.

warnings = "-29"

supported_targets = "js + native + wasm"

options(
  targets: {
    "interaction_http.js.mbt": [ "js" ],
    "interaction_http_js_wbtest.mbt": [ "js" ],
    "pkg.generated.mbti": [ "native" ],
  },
)
