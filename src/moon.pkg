import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/http" @dhttp,
  "gaato/discord/gateway",
  "gaato/discord/voice",
  "gaato/discord/interaction",
  "gaato/discord/framework",
  "gaato/discord/app",
  "gaato/discord/bot",
  "gaato/discord/coordinator",
  "gaato/discord/endpoint_http",
  "gaato/discord/verify",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/async",
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/interaction",
  "gaato/discord/http" @dhttp,
} for "test"

// Native-only facade imports are unused when facade_native.mbt is excluded.

warnings = "-29"

supported_targets = "js + native"

options(
  targets: {
    "README.mbt.md": [ "native" ],
    "facade_native.mbt": [ "native" ],
    "readme_native_test.mbt": [ "native" ],
  },
)
