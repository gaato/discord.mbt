import {
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
  "gaato/discord/gateway",
  "gaato/discord/interaction",
  "gaato/discord/framework",
  "gaato/discord/app",
  "gaato/discord/bot",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/async",
  "gaato/discord/model",
  "gaato/discord/interaction",
} for "test"

// Native-only facade imports are unused when facade_native.mbt is excluded.

warnings = "-29"

options(
  targets: {
    "README.mbt.md": [ "native" ],
    "facade_native.mbt": [ "native" ],
    "readme_native_test.mbt": [ "native" ],
  },
)
