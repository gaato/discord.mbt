import {
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
  "gaato/discord/interaction",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
} for "test"

import {
  "moonbitlang/core/json",
} for "wbtest"

// `member` is part of the public TargetUser API, but MoonBit currently marks
// it as a possible future keyword before local warning attributes take effect.

warnings = "-35"

supported_targets = "js + native + wasm"
