import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/cache",
  "gaato/discord/http" @dhttp,
  "gaato/discord/gateway",
  "gaato/discord/queue",
  "gaato/discord/framework",
  "gaato/discord/app",
  "gaato/discord/voice",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
}

import {
  "moonbitlang/core/json",
  "gaato/discord/telemetry",
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
} for "test"

import {
  "gaato/discord/interaction",
  "gaato/discord/internal/clock",
  "moonbitlang/core/json",
  "moonbitlang/async/aqueue",
} for "wbtest"

// This package is intentionally empty on non-native targets.

warnings = "-29"

supported_targets = "js + native"

options(
  targets: {
    "bot.mbt": [ "native" ],
    "collector.mbt": [ "native" ],
    "collector_wbtest.mbt": [ "native" ],
    "bot_wbtest.mbt": [ "native" ],
    "ctx.mbt": [ "native" ],
    "events.mbt": [ "native" ],
    "middleware.mbt": [ "native" ],
    "voice.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "runtime_wbtest.mbt": [ "native" ],
    "shard_manager.mbt": [ "native" ],
    "shard_manager_wbtest.mbt": [ "native" ],
  },
)
