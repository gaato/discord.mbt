import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/cache",
  "gaato/discord/http" @dhttp,
  "gaato/discord/gateway",
  "gaato/discord/queue",
  "gaato/discord/framework",
  "gaato/discord/app",
  "gaato/discord/voice",
  "moonbitlang/core/json",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
}

import {
  "moonbitlang/core/json",
  "gaato/discord/telemetry",
  "gaato/discord/model",
  "gaato/discord/http" @dhttp,
} for "test"

import {
  "gaato/discord/interaction",
  "gaato/discord/internal/clock",
  "moonbitlang/core/json",
  "moonbitlang/async/aqueue",
} for "wbtest"

// The gateway executor runs on native, JavaScript, and moonrun Wasm; voice is native-only.

// `resume` is the public API label and is reserved by the current compiler.

warnings = "-29-35"

supported_targets = "js + native + wasm"

options(
  targets: {
    "bot.mbt": [ "js", "native", "wasm" ],
    "collector.mbt": [ "js", "native", "wasm" ],
    "collector_wbtest.mbt": [ "js", "native", "wasm" ],
    "bot_wbtest.mbt": [ "js", "native", "wasm" ],
    "ctx.mbt": [ "js", "native", "wasm" ],
    "ctx_accessors_wbtest.mbt": [ "js", "native", "wasm" ],
    "events.mbt": [ "js", "native", "wasm" ],
    "events_projection_wbtest.mbt": [ "js", "native", "wasm" ],
    "middleware.mbt": [ "js", "native", "wasm" ],
    "voice.mbt": [ "native" ],
    "voice_unsupported.mbt": [ "js", "wasm" ],
    "bot_voice_wbtest.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "runtime_wbtest.mbt": [ "js", "native", "wasm" ],
    "session.mbt": [ "js", "native", "wasm" ],
    "session_test.mbt": [ "js", "native", "wasm" ],
    "shard_manager.mbt": [ "js", "native", "wasm" ],
    "shard_manager_wbtest.mbt": [ "js", "native", "wasm" ],
  },
)
