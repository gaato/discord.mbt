import {
  "gaato/discord/model",
  "gaato/discord/telemetry",
  "gaato/discord/ratelimit",
  "gaato/discord/internal/pool",
  "gaato/discord/internal/clock",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "gaato/discord/model",
} for "test"

import {
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
} for "wbtest"

// REST transport depends on async HTTP, available on native and JavaScript.

supported_targets = "js + native"

options(
  targets: {
    // The loopback @ahttp.Server used by the wire tests is native-only.
    "loopback_server_wbtest.mbt": [ "native" ],
  },
)
