///|
/// Audit the repository's Markdown:
///
/// 1. Shell examples: no code block is fenced as `fish`; commands are written
///    for POSIX `sh`.
/// 2. Published links: a Markdown file inside a published module directory
///    links only to absolute URLs or anchors. mooncakes.io renders these
///    files away from the repository, so a relative link breaks there.
/// 3. Repository links: every other relative link names a file or directory
///    that exists.
///
/// Deliberate exceptions live in `scripts/docs_audit.allow`, one
/// `<file> <link>` per line with a ` #` reason. Unknown or stale entries fail
/// the audit.
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

///|
/// Directory names the walk skips: build output, dependencies, and VCS data.
let skipped_dirs : Array[String] = [
  "_build", ".mooncakes", "node_modules", "target", ".git", ".jj", ".wrangler",
]

///|
/// Published module directories, and their subdirectories that the package
/// leaves out.
let published_modules : Array[String] = ["discord", "discord_voice", "dave"]

///|
let unpublished_subdirs : Array[String] = ["shim", "test"]

///|
fn is_published(path : String) -> Bool {
  published_modules
  .iter()
  .any(dir => {
    path.has_prefix("\{dir}/") &&
    !unpublished_subdirs.iter().any(sub => path.has_prefix("\{dir}/\{sub}/"))
  })
}

///|
/// `line` with inline code spans removed, so links shown as code are skipped.
fn without_code_spans(line : String) -> String {
  let out = StringBuilder()
  let mut in_code = false
  for c in line {
    if c == '`' {
      in_code = !in_code
    } else if !in_code {
      out.write_char(c)
    }
  }
  out.to_string()
}

///|
/// The targets of `[text](target)` links on `line`.
fn link_targets(line : String) -> Array[String] {
  let targets : Array[String] = []
  let chars = without_code_spans(line).to_array()
  for i in 0..<chars.length() {
    guard chars[i] == ']' && i + 1 < chars.length() && chars[i + 1] == '(' else {
      continue
    }
    let target = StringBuilder()
    let mut depth = 0
    for j in (i + 2)..<chars.length() {
      let c = chars[j]
      if c == '(' {
        depth += 1
      } else if c == ')' {
        if depth == 0 {
          break
        }
        depth -= 1
      }
      target.write_char(c)
    }
    let text = target.to_string().trim().to_owned()
    // `[text](target "title")` keeps only the target.
    let text = match text.find(" ") {
      Some(space) => text[:space].to_owned()
      None => text
    }
    targets.push(text)
  }
  targets
}

///|
fn is_external(target : String) -> Bool {
  target.has_prefix("http://") ||
  target.has_prefix("https://") ||
  target.has_prefix("mailto:") ||
  target.has_prefix("#")
}

///|
/// `target` resolved against the directory of `file`, without its anchor.
fn resolve(file : String, target : String) -> String {
  let target = match target.find("#") {
    Some(hash) => target[:hash].to_owned()
    None => target
  }
  let parts : Array[String] = file.split("/").map(p => p.to_owned()).to_array()
  ignore(parts.pop())
  for part in target.split("/") {
    match part {
      "" | "." => ()
      ".." => ignore(parts.pop())
      _ => parts.push(part.to_owned())
    }
  }
  parts.join("/")
}

///|
/// Problems keyed `<file> <link>` (or `<file> fish:<line>` for a fence),
/// each with its message.
fn scan(
  files : Array[(String, String)],
  existing : Set[String],
) -> Map[String, String] {
  let found : Map[String, String] = Map([])
  for file in files {
    let (path, text) = file
    let mut in_fence = false
    for index, line in text.split("\n").to_array() {
      let trimmed = line.trim().to_owned()
      if trimmed.has_prefix("```") {
        if !in_fence && trimmed.has_prefix("```fish") {
          found["\{path} fish:\{index + 1}"] = "a `fish` code block; write the commands for sh"
        }
        in_fence = !in_fence
        continue
      }
      if in_fence {
        continue
      }
      for target in link_targets(line.to_owned()) {
        if target.is_empty() || is_external(target) {
          continue
        }
        if is_published(path) {
          found["\{path} \{target}"] = "relative link in a published file; mooncakes.io cannot follow it, use an absolute URL"
        } else if !existing.contains(resolve(path, target)) {
          found["\{path} \{target}"] = "link to a missing file"
        }
      }
    }
  }
  found
}

///|
fn parse_allow(text : String) -> Set[String] raise {
  let allowed : Set[String] = Set([])
  for raw in text.split("\n") {
    let line = raw.trim().to_owned()
    if line.is_empty() || line.has_prefix("#") {
      continue
    }
    // The reason starts at ` #`, so a link's own `#fragment` stays in the key.
    guard line.find(" #") is Some(hash) && !line[hash + 2:].trim().is_empty() else {
      fail("allow entry requires a reason: \{line}")
    }
    let key = line[:hash].trim().to_owned()
    if allowed.contains(key) {
      fail("duplicate allow entry: \{key}")
    }
    allowed.add(key)
  }
  allowed
}

///|
fn audit(
  files : Array[(String, String)],
  existing : Set[String],
  allow : String,
) -> Unit raise {
  let allowed = parse_allow(allow)
  let found = scan(files, existing)
  let problems : Array[String] = []
  for key, message in found {
    if !allowed.contains(key) {
      problems.push("\{key}: \{message}")
    }
  }
  for key in allowed {
    if !found.contains(key) {
      problems.push("stale allow entry: \{key}")
    }
  }
  if !problems.is_empty() {
    problems.sort()
    fail(problems.join("\n"))
  }
}

///|
fn must_fail(run : () -> Unit raise) -> Unit raise {
  try run() catch {
    _ => ()
  } noraise {
    _ => fail("negative docs audit self-test unexpectedly passed")
  }
}

///|
async fn main {
  let args = @env.args()
  let self_test = args.length() == 2 && args[1] == "--self-test"
  if args.length() > 2 || (args.length() == 2 && !self_test) {
    fail("usage: moon run scripts/docs_audit.mbtx [--self-test]")
  }
  let existing : Set[String] = Set([])
  let paths : Array[String] = []
  @fs.walk(
    ".",
    (dir, entries) => {
      let prefix = if dir == "." {
        ""
      } else {
        dir["./".length():].to_owned() + "/"
      }
      for entry in entries {
        existing.add(prefix + entry)
        if entry.has_suffix(".md") {
          paths.push(prefix + entry)
        }
      }
    },
    exclude=path => skipped_dirs.iter().any(name => path.has_suffix("/\{name}")),
    max_concurrency=1,
  )
  paths.sort()
  let files : Array[(String, String)] = []
  for path in paths {
    files.push((path, @fs.read_file(path).text()))
  }
  let allow = @fs.read_file("scripts/docs_audit.allow").text()
  audit(files, existing, allow)
  if self_test {
    let with_file = (path : String, text : String) => {
      files.copy()..push((path, text))
    }
    // A fish fence fails; one inside another fence's body does not open one.
    must_fail(() => {
      audit(with_file("guide/x.md", "```fish\nls\n```\n"), existing, allow)
    })
    audit(with_file("guide/x.md", "```sh\nls\n```\n"), existing, allow)
    // A relative link fails in a published file and passes elsewhere when
    // its target exists.
    let relative = "See [the guide](../guide/README.md).\n"
    must_fail(() => audit(with_file("discord/x.md", relative), existing, allow))
    audit(with_file("examples/x.md", relative), existing, allow)
    audit(
      with_file(
        "discord/x.md", "See [the guide](https://github.com/gaato/discord.mbt/blob/main/guide/README.md#guides).\n",
      ),
      existing,
      allow,
    )
    // A missing target fails; links in code spans and blocks are ignored.
    must_fail(() => {
      audit(with_file("guide/x.md", "[gone](missing.md)\n"), existing, allow)
    })
    audit(with_file("guide/x.md", "`[gone](missing.md)`\n"), existing, allow)
    audit(
      with_file("guide/x.md", "```text\n[gone](missing.md)\n```\n"),
      existing,
      allow,
    )
    // Allow entries cover one link each and go stale when it goes away.
    let allowed = allow + "\nguide/x.md missing.md # self-test\n"
    audit(with_file("guide/x.md", "[gone](missing.md)\n"), existing, allowed)
    must_fail(() => audit(files, existing, allowed))
    must_fail(() => audit(files, existing, allow + "\nguide/x.md y.md\n"))
    // A link's fragment is part of its entry, not the start of the reason.
    audit(
      with_file("guide/x.md", "[gone](missing.md#part)\n"),
      existing,
      allow + "\nguide/x.md missing.md#part # self-test\n",
    )
    println("Docs audit self-tests: OK")
  }
  println("Docs audit: OK")
}
