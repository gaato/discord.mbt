///|
// Normalize Markdown links, not endpoint names or formats. Unexpected syntax
// remains visible and therefore fails comparison instead of disappearing.
fn normalize_path(path : String) -> String raise {
  let output = StringBuilder()
  let mut in_link = false
  for char in path {
    if in_link {
      if char == ')' {
        in_link = false
      }
    } else if char == '[' {
      output.write_string("{}")
      in_link = true
    } else if char == '\\' || char == '*' {
      continue
    } else {
      output.write_char(char)
    }
  }
  if in_link {
    fail("unterminated CDN Markdown link")
  }
  let normalized = output.to_string().trim().to_owned()
  normalized.strip_suffix(".png").unwrap_or(normalized[:]).to_owned()
}

///|
fn rows(text : String) -> Map[String, (String, String)] raise {
  let found : Map[String, (String, String)] = Map([])
  let mut active = false
  let mut header = false
  for raw in text.split("\n") {
    let line = raw.trim().to_owned()
    if line == "**CDN Endpoints**" {
      active = true
      continue
    }
    if !active {
      continue
    }
    if !line.has_prefix("|") {
      if !found.is_empty() {
        break
      }
      continue
    }
    let cells = line.split("|").map(cell => cell.trim().to_owned()).to_array()
    if cells.length() != 5 {
      fail("malformed CDN table row")
    }
    if cells[1] == "Type" {
      if cells[2] != "Path" || cells[3] != "Supports" {
        fail("unexpected CDN header")
      }
      header = true
      continue
    }
    if cells[1].has_prefix("---") {
      continue
    }
    if !header || found.contains(cells[1]) {
      fail("missing header or duplicate CDN endpoint")
    }
    found[cells[1]] = (normalize_path(cells[2]), cells[3])
  }
  if !active || !header || found.is_empty() {
    fail("missing or empty CDN table")
  }
  found
}

///|
fn audit(text : String, allow_text : String, source : String) -> Unit raise {
  let actual = rows(text)
  let allowed : Set[String] = Set([])
  for raw in allow_text.split("\n") {
    let line = raw.trim().to_owned()
    if line.is_empty() || line.has_prefix("#") {
      continue
    }
    let parts = line.split("#").to_array()
    if parts.length() < 2 || parts[1].trim().is_empty() {
      fail("allow entry requires a reason")
    }
    let name = parts[0].trim().to_owned()
    if allowed.contains(name) {
      fail("duplicate allow entry: \{name}")
    }
    allowed.add(name)
  }
  let expected = baseline()
  if actual.length() != expected.length() {
    fail("CDN table row count changed")
  }
  for endpoint in expected {
    guard actual.get(endpoint.name) is Some((path, formats)) else {
      fail("missing endpoint: \{endpoint.name}")
    }
    if path != endpoint.path || formats != endpoint.formats {
      fail(
        "CDN path/formats drift: \{endpoint.name}: \{path} [\{formats}], expected \{endpoint.path} [\{endpoint.formats}]",
      )
    }
    match endpoint.builder {
      Some(builder) => {
        if allowed.contains(endpoint.name) {
          fail("stale allow entry: \{endpoint.name}")
        }
        if !source.contains("pub fn \{builder}(") {
          fail("missing builder: \{builder}")
        }
      }
      None => {
        if !allowed.contains(endpoint.name) {
          fail("unexplained endpoint: \{endpoint.name}")
        }
        allowed.remove(endpoint.name)
      }
    }
  }
  if !allowed.is_empty() {
    fail("unknown or stale allow entries")
  }
}

///|
fn must_fail(run : () -> Unit raise) -> Unit raise {
  try run() catch {
    _ => ()
  } noraise {
    _ => fail("negative audit self-test unexpectedly passed")
  }
}

///|
async fn main {
  let args = @env.args()
  if args.length() < 2 || args.length() > 3 {
    fail(
      "usage: moon run scripts/docs_cdn_audit.mbtx REFERENCE.mdx [--self-test]",
    )
  }
  let text = @fs.read_file(args[1]).text()
  let allow = @fs.read_file("scripts/docs_cdn_audit.allow").text()
  let source = @fs.read_file("src/util/cdn.mbt").text()
  audit(text, allow, source)
  if args.length() == 3 {
    if args[2] != "--self-test" {
      fail("unknown option")
    }
    must_fail(() => audit("", allow, source))
    must_fail(() => {
      audit("**CDN Endpoints**\n| Type | Path | Supports |\n", allow, source)
    })
    must_fail(() => {
      audit(text.replace(old="Guild Icon", new="Unknown Icon"), allow, source)
    })
    must_fail(() => {
      audit(text.replace(old="emojis/", new="emoji-assets/"), allow, source)
    })
    must_fail(() => {
      audit(
        text.replace(old="PNG, JPEG, WebP, GIF", new="PNG, GIF"),
        allow,
        source,
      )
    })
    must_fail(() => audit(text, allow + "\nGuild Icon # stale\n", source))
    must_fail(() => audit(text, allow + "\nRemoved Endpoint # stale\n", source))
    must_fail(() => audit(text, "", source))
    must_fail(() => audit(text, allow, ""))
    must_fail(() => {
      ignore(rows("**CDN Endpoints**\n| Type | Path | Supports |\n| broken |"))
    })
    println("CDN audit self-tests: OK")
  }
  println("CDN endpoints: OK (22 rows; URL behavior is checked by util tests)")
}
